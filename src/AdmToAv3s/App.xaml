<Application x:Class="AdmToAv3s.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
   <SolidColorBrush x:Key="AccentBrush" Color="#8FAFFF" />
   <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="#161D2B" />
    <Setter Property="BorderBrush" Value="#2B3548" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="24" />
   </Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
